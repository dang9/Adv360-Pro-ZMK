#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };
    };

    combos {
      compatible = "zmk,combos";
      combo_esc_left {
        timeout-ms = <50>;
        key-positions = <31 32>;
        bindings = <&kp ESC>;
        layers = <0>;
      };
      combo_esc_right {
        timeout-ms = <50>;
        key-positions = <41 42>;
        bindings = <&kp ESC>;
        layers = <0>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp EQUAL &kp N1    &kp N2    &kp N3   &kp N4     &kp N5 &tog 1                                                                  &mo 3  &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &kp MINUS
        &kp TAB   &kp Q     &kp W     &kp F    &kp P      &kp B  &none                                                                   &none  &kp J  &kp L     &kp U     &kp Y    &kp SQT  &kp DEL
        &sk LALT  &kp A     &kp R     &kp S    &kp T      &kp G  &none           &kp LCTRL &kp LALT  &kp LGUI  &kp RCTRL                  &none  &kp M  &kp N     &kp E     &kp I    &kp O    &sk LGUI
        &sk LSHFT &kp Z     &kp X     &kp C    &kp D      &kp V                             &kp HOME  &kp PG_UP                                  &kp K  &kp H     &kp COMMA &kp DOT  &kp FSLH &sl 3
        &mo 2     &kp ESC   &kp C_MUTE &kp LEFT &kp RIGHT              &sk LCTRL &hm LGUI ENTER &lt 1 TAB  &lt 2 BSPC &kp SPACE &sk LSHFT              &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo 2
      >;
    };
    sym {
      display-name = "Sym";
      bindings = <
        &trans    &trans    &trans    &trans    &trans     &trans &trans                                                                    &trans &trans    &trans    &trans    &trans   &trans   &trans
        &trans    &kp EXCL  &kp AT    &kp HASH &kp DLLR   &kp PRCNT &none                                                                &none  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &trans
        &trans    &kp N1    &kp N2    &kp N3   &kp N4     &kp N5 &none           &trans    &trans    &trans    &trans                      &none  &kp N6    &kp N7    &kp N8    &kp N9   &kp N0   &trans
        &trans    &none     &kp TILDE &kp GRAVE &kp LBKT  &kp LBRC                          &trans    &trans                                      &kp RBRC  &kp RBKT  &none     &none    &none    &trans
        &trans    &trans    &trans    &trans    &trans                   &trans &trans &trans  &trans &trans &kp COLON                                &trans    &trans    &trans    &trans   &trans
      >;
    };
    nav {
      display-name = "Nav";
      bindings = <
        &trans    &trans    &trans    &trans      &trans     &trans &trans                                                                    &trans &trans    &trans    &trans    &trans   &trans   &trans
        &trans    &none     &none     &kp UNDER   &kp PLUS   &kp PG_UP &none                                                                &none  &kp PIPE  &kp BSLH  &none     &none    &none    &trans
        &trans    &kp HOME  &kp END   &kp MINUS   &kp EQUAL  &kp PG_DN &none           &trans    &trans    &trans    &trans                  &none  &none     &kp RIGHT &kp UP    &kp DOWN &kp LEFT &trans
        &trans    &kp LT    &kp GT    &none       &none      &kp SEMI                             &trans    &trans                                  &none     &none     &none     &none    &kp C_PP &trans
        &trans    &trans    &trans    &trans      &trans                      &trans &trans &trans  &trans &trans &trans                               &trans    &trans    &trans    &trans   &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                                     &trans                 &none        &none        &none        &none &none &none
        &none &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &bootloader                                                               &bootloader            &none        &none        &none        &none &none &none
        &studio_unlock &kp F6 &kp F7   &kp F8       &kp F9       &kp F10      &none                   &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none &none        &none        &none        &kp F11      &kp F12                                    &none &none                                                        &none        &none        &none        &none &none &none
        &none &none        &none        &none        &macro_ver                                  &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                                     &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
